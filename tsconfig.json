{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ES2020",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "strict": true,
      "declaration": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
}